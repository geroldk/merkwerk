# TEMPLATE, not installed by anything. Copy to ~/.config/systemd/user/ and adjust the paths.
[Unit]
Description=Basic Memory Git peer sync (one pass over all projects)
After=basic-memory-mcp.service

[Service]
Type=oneshot
# The tool's own Python has fastmcp. The scripts are fixed copies in ~/bm/bin (git_sync_watch.py,
# bm_host_settings.py, bm_notify.py, bm-notify), not the working tree of a checkout. What differs
# per machine (host name, projects, notify project) is in ~/.config/merkwerk/host.json.
# --notify-always lets bm-notify deliver queued messages even when nothing new is reported.
ExecStart=%h/.local/share/uv/tools/basic-memory/bin/python %h/bm/bin/git_sync_watch.py \
  --notify-cmd "%h/bm/bin/bm-notify" --notify-always
# Exit status 3 means: at least one project needs a person. Systemd then lists the unit as failed.
SuccessExitStatus=0
TimeoutStartSec=300
UMask=0077
